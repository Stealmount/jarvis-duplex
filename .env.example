# ─────────────────────────────────────────────────────────────
# JARVIS — Unified Next.js Configuration
# Copy this file to .env.local and fill in your keys.
# ─────────────────────────────────────────────────────────────

# ── Auth & NextAuth (Required for login / guest sessions) ────
# Generate a secret using: openssl rand -base64 32
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3000

# Optional Google OAuth Keys (if enabling Google login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Database (Required for persisting messages, threads, and usage limit) ──
# Set up a Supabase project and paste the credentials here
SUPABASE_URL=https://your_project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── Speech-to-Text (Required for Voice VAD) ──────────────────
# Free at: https://console.groq.com
GROQ_API_KEY=

# ── Image Generation & TTS Providers ─────────────────────────
# Seedream API (for the 'Imagine' page)
SEEDREAM_KEY_1=
SEEDREAM_KEY_2=

# Stability AI
STABILITY_API_KEY=

# ElevenLabs API (optional, for ultra-realistic voice TTS)
ELEVENLABS_KEY=
ELEVENLABS_VOICE_MALE=
ELEVENLABS_VOICE_FEMALE=

# ── Web Search ────────────────────────────────────────────────
# Tavily Search API (optional, for 'Research' mode real-time web access)
# Get key: https://tavily.com
TAVILY_API_KEY=

# ── LLM Providers (Add any/all you have) ──────────────────────
# Next.js will auto-select the best available active provider.
ANTHROPIC_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
NVIDIA_API_KEY=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
SARVAM_API_KEY=
HF_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
KIMI_API_KEY=
MINIMAX_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
AIMLAPI_API_KEY=

# ── Server & Companion Settings ──────────────────────────────
PORT=3000
DAILY_MESSAGE_LIMIT=50
