# ─────────────────────────────────────────────────────────────
# JARVIS — API Keys Configuration
# Copy this file to .env and fill in your keys.
# This file stays on your machine/server ONLY — never shared.
# ─────────────────────────────────────────────────────────────

# ── STT (Speech-to-Text) — REQUIRED ──────────────────────────
# Free at: https://console.groq.com → API Keys
GROQ_API_KEY=gsk_your_key_here

# ── LLM Providers — add any/all you have ─────────────────────
# Server auto-selects the best available provider.
# You only NEED one. More = better fallback coverage.

# DeepSeek — Recommended. Free tier. Best reasoning + Hinglish.
# Get key: https://platform.deepseek.com → API Keys
DEEPSEEK_API_KEY=

# OpenRouter — 50+ free models with :free suffix
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Together AI — Free tier
# Get key: https://api.together.xyz/settings/api-keys
TOGETHER_API_KEY=

# Google Gemini — Free tier (Gemini 1.5 Flash)
# Get key: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# NVIDIA NIM — Free tier (Llama 405B!)
# Get key: https://build.nvidia.com → Get API Key
NVIDIA_API_KEY=

# OpenAI — Paid, but supported if you have a key
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Sarvam AI — Indian language TTS (optional, for native Indian voice)
# Get key: https://app.sarvam.ai
SARVAM_API_KEY=

# ── Server Settings ───────────────────────────────────────────
PORT=3000
AUTO_FALLBACK=true

# auto | deepseek | groq | openrouter | google | nvidia | together | openai
DEFAULT_PROVIDER=auto
