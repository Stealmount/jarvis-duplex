{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy",  "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
      ]
    }
  ],
  "functions": {
    "app/api/chat/route.js":   { "maxDuration": 30 },
    "app/api/stt/route.js":    { "maxDuration": 15 },
    "app/api/upload/route.js": { "maxDuration": 30 },
    "app/api/tts/route.js":    { "maxDuration": 20 }
  }
}
